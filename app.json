{
  "expo": {
    "name": "Zigzag Messenger",
    "slug": "zigzag-messenger",
    "scheme": "zigzag",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zigzag.messenger",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.zigzag.messenger",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true
    }
  }
}
